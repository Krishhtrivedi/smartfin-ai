# SmartFin Mac agent settings. Copy to agent.env and fill in. Do NOT commit agent.env.
# Your Render site + /api/v1
SMARTFIN_API_URL=https://smartfin-ai-kg6b.onrender.com/api/v1
# Same value as AGENT_API_TOKEN in Render -> Environment
AGENT_API_TOKEN=
# Where client folders live (Desktop/<Client Folder>/...)
CLIENT_ROOT_DIR=~/Desktop
# Name shown in SmartFin for this Mac
AGENT_NAME=Office Mac
# Optional: Income Tax "Outstanding Demand" page URL to read as well
IT_DEMAND_URL=
