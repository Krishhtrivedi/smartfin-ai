# ==============================================================================
# SMARTFIN.AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your production credentials.
# Never commit the .env file containing live secrets into version control.

# Application & Security
PROJECT_NAME="SmartFin AI – Finance & Office Automation System"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-32-chars-min"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Database Configuration (SQLite default; PostgreSQL supported for high concurrency)
# For local development:
DATABASE_URL="sqlite:///./smartfin.db"
# For Render / PostgreSQL production with persistent disk:
# DATABASE_URL="postgresql://user:password@hostname:5432/smartfin_db"

# AI / LLM Intelligence Layer (Google Gemini / OpenAI GPT-4o-mini)
# Required for AI Finance Assistant, Consulting Generator, SOP Chatbot, and Document Analyzer
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Storage Directories & Mac Desktop Folder Hierarchy
STORAGE_DESKTOP_PATH="~/Desktop"
CLIENT_ROOT_DIR="~/Desktop"
UPLOAD_DIR="uploads"
EXPORT_DIR="exports"
ITR_ARCHIVE_DIR="uploads/itr_archives"
GSTR_INBOX_DIR="uploads/gstr_returns"

# SMTP Email Configuration (For GSTR Return PDFs auto-dispatch & ITR archive bundles)
# Uses standard TLS (port 587) or SSL (port 465). No mock emails will be sent if missing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="SmartFin.AI Compliance Desk"
SMTP_TLS="true"

# WhatsApp Web & Baileys Micro-Bridge (Port 8001)
# Primary direct mode uses QR scan or 8-digit pairing code stored in session directory.
WHATSAPP_BRIDGE_PORT="8001"
WHATSAPP_SESSION_DIR=""
WHATSAPP_AUTO_SCHEDULE_TIME="18:30"
WHATSAPP_AUTO_SCHEDULE_ENABLED="true"

# Optional External WhatsApp Gateway (e.g., UltraMsg, WATI, Meta Cloud API)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PMSC_GROUP_ID=""

# Financial Engine Tolerances
GST_TOLERANCE_AMOUNT="1.0"
BANK_TOLERANCE_DAYS="4"
